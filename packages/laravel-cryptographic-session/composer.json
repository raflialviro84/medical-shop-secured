{
    "name": "csb/laravel-cryptographic-session",
    "description": "Modular Cryptographic Session Binding (DPoP / Web Crypto ECDSA) for Laravel Web Sessions",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Developer",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CryptographicSession\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CryptographicSession\\CryptographicSessionServiceProvider"
            ],
            "aliases": {
                "CryptographicSession": "CryptographicSession\\Facades\\CryptographicSession"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

